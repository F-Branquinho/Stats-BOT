# Everything here is optional: the setup page saves these values in data/settings.json.
# A value set here wins over the one saved on the setup page.

# Discord application (Developer Portal)
# BOT_TOKEN=
# DISCORD_CLIENT_SECRET=

# Public address of the website, without a trailing slash
# PUBLIC_URL=https://stats.example.com

# Leetify API key (optional, raises the rate limits): https://leetify.com/app/developer
# LEETIFY_API_KEY=

# FACEIT Data API key (optional): FACEIT matches Leetify doesn't have, plus FACEIT level and ELO.
# Create a server-side key at https://developers.faceit.com (App Studio → your app → API Keys)
# FACEIT_API_KEY=

# Maximum Leetify requests per day (default 3000)
# LEETIFY_DAILY_BUDGET=3000

# Where the bot keeps its database and settings (default ./data)
# DATA_DIR=

# Website address and port (default 0.0.0.0:3000)
# WEB_HOST=0.0.0.0
# WEB_PORT=3000
