[Unit]
Description=Stats BOT (CS2 stats for Discord)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=statsbot
Group=statsbot
WorkingDirectory=/opt/stats-bot
# Read by systemd (as root), so the .env can stay readable by root only
EnvironmentFile=/opt/stats-bot/.env
Environment=NODE_ENV=production
Environment=DATA_DIR=/opt/stats-bot/data
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
